# Copy thành .env rồi điền giá trị thật:  cp .env.example .env
# KHÔNG commit .env (đã nằm trong .gitignore)

PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Bắt buộc khi ENVIRONMENT=production — tạo bằng: openssl rand -hex 24
AGENT_API_KEY=

# Docker Compose tự ghi đè thành redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
